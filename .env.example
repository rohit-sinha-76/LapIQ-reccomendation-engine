# Environment Configuration Template for LapIQ

# Application
ENVIRONMENT=development
LOG_LEVEL=INFO
SECRET_KEY=change-this-in-production-secret-key-32-chars-min
CORS_ORIGINS=["http://localhost:3000"]

# Database (PostgreSQL 16 + pgvector)
POSTGRES_USER=lapiq
POSTGRES_PASSWORD=lapiq_dev_password
POSTGRES_DB=lapiq_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://lapiq:lapiq_dev_password@postgres:5432/lapiq_db

# Cache (Redis 8.0.x)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# LLM Reasoning Provider (Gemini API via google-genai)
GEMINI_API_KEY=your_gemini_api_key_here

# External Providers (Catalog / Price / Evidence)
CATALOG_PROVIDER_API_KEY=
PRICE_PROVIDER_API_KEY=
EVIDENCE_PROVIDER_API_KEY=
